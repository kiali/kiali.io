{
  "name": "kiali-doc-hugo",
  "version": "1.0.0",
  "description": "Kiali technical documentation.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiali/kiali.io.git"
  },
  "author": "Kiali",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kiali/kiali/issues"
  },
  "homepage": "https://kiali.io",
  "workspaces": [
    "packages/hugoautogen"
  ],
  "scripts": {
    "_hugo": "hugo --cleanDestinationDir",
    "_hugo-bin": "hugo",
    "_netlify:prepare": "npm run install:safe",
    "_prepare:modules": "npm run _hugo-bin -- mod get && npm run update:docsy:pack",
    "approve:hugo": "npm run install:safe && npm approve-scripts --allow-scripts-pin hugo-extended && npm rebuild hugo-extended --ignore-scripts=false && npm run update:docsy:pack",
    "build:preview": "npm run _prepare:modules && npm run _hugo -- --minify --baseURL \"${DEPLOY_PRIME_URL:-/}\"",
    "build:production": "npm run _prepare:modules && npm run _hugo -- --minify",
    "install:safe": "npm ci --ignore-scripts && node scripts/fix-sass-bin.mjs",
    "serve": "npm run _hugo -- serve --baseURL http://localhost:1313/ --bind 0.0.0.0 --disableFastRender --noHTTPCache --poll 1s",
    "update:docsy:pack": "npm run _hugo-bin -- mod npm pack && npm pkg set 'name=\"@kiali/hugoautogen\"' private=true --json --prefix packages/hugoautogen && npm install --ignore-scripts && node scripts/fix-sass-bin.mjs"
  },
  "devDependencies": {
    "hugo-extended": "0.168.0",
    "sass-embedded": "1.105.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "hugo-extended@0.168.0": true
  }
}
